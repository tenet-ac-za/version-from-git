#!/usr/bin/env php
<?php

// phpcs:disable PSR1.Files.SideEffects.FoundWithSymbols

declare(strict_types=1);

define('PROGRAM_NAME', basename($argv[0] ?? __FILE__));

use Composer\Semver\Semver;
use Composer\Semver\VersionParser;

/**
 * Display the usage information for the script.
 *
 * @param bool $long Whether to display the long usage information.
 */
function usage(bool $long = false): never
{
    global $argv;
    fwrite(
        STDERR,
        'Usage: ' . PROGRAM_NAME . ' [--repo=<repo>] [--sshkey=<ssh_key>] <constraint[@stability]>' . PHP_EOL,
    );
    if ($long) {
        fwrite(STDERR, 'Options:' . PHP_EOL);
        fwrite(STDERR, '  --repo=<repo>       The git repository to query (default: current directory)' . PHP_EOL);
        fwrite(STDERR, '  --verbose, -v       Enable debug output' . PHP_EOL);
        fwrite(STDERR, '  --output=<output>   The output format for the version information' . PHP_EOL);
        fwrite(STDERR, '  --verbose, -v       Enable debug output' . PHP_EOL);
        fwrite(STDERR, '  --help, -?          Show this help message' . PHP_EOL);
    }
    exit(2);
}

/**
 * Display an error message and exit the script.
 *
 * @param string $message The error message to display.
 * @param int $exitCode The exit code
 * @param string $outform The output format (default: 'text').
 */
function error(string $message, int $exitCode = 1, string $outform = 'text'): never
{
    switch ($outform) {
        case 'json':
            echo json_encode(['error' => $message]);
            break;
        case 'text':
        default:
            fwrite(STDERR, $message . PHP_EOL);
            break;
    }

    exit($exitCode);
}

/**
 * Display a verbose message if verbose mode is enabled.
 *
 * @param string $message The message to display.
 */
function verbose(string $message): void
{
    global $VERBOSE;
    if ($VERBOSE) {
        echo $message . PHP_EOL;
    }
}

/**
 * Get all versions (tags and branches) from a git repository.
 *
 * @param string $repo The path to the git repository or the remote URL.
 * @param string|null $sshKey The SSH key to use for accessing the repository.
 * @param \Composer\Semver\VersionParser|null $versionParser The version parser instance.
 * @return array<string, array{refspec: string, commit: string}> Normalized versions to their git references.
 */
function getRepoVersions(string $repo, ?string $sshKey = null, ?VersionParser $versionParser = null): array
{
    global $GITCMD;
    if (is_dir($repo)) {
        $command = sprintf('%s -C %s show-ref --tags --heads', $GITCMD, escapeshellarg($repo));
    } else {
        $command = sprintf(
            "%s%s ls-remote -q --heads --tags %s",
            $GITCMD,
            $sshKey !== null ?  ' -c core.sshCommand=' . escapeshellarg('ssh -i ' . $sshKey) : '',
            escapeshellarg($repo),
        );
    }
    $output = [];
    $returnVar = 0;

    verbose("Executing command: $command");
    exec($command, $output, $returnVar);
    if ($returnVar !== 0) {
        error('Failed to get versions from git repository', 2);
    }

    $versions = [];
    $versionParser = $versionParser ?? new VersionParser();
    foreach ($output as $line) {
        [$commit, $refspec] = preg_split('#\s+#', $line, 2) ?: [null, null];
        if ($commit === null || $refspec === null) {
            continue;
        }
        if (preg_match('#refs/(tags|heads)/(.+)$#', $refspec, $matches)) {
            $type = $matches[1];
            $name = $matches[2];
            if ($type === 'heads') {
                $name = $versionParser->normalize(preg_match('/^\d+/', $name) ? $name . '-dev' : 'dev-' . $name);
            } else {
                $name = $versionParser->normalize($name);
            }
            $versions[$name] = ['refspec' => $refspec, 'commit' => $commit];
        }
    }
    verbose("Found versions: " . implode(', ', array_keys($versions)));
    return $versions;
}

/**
 * Filter versions by stability.
 *
 * @param array<string> $versions The list of versions to filter.
 * @param string $stability The desired stability (e.g., 'stable', 'beta').
 * @param \Composer\Semver\VersionParser|null $versionParser The version parser instance.
 * @return array<string> The filtered list of versions matching the desired stability.
 */
function filterByStability(
    array $versions,
    string $stability = 'stable',
    bool $required = false,
    ?VersionParser $versionParser = null,
): array {
    $versionParser = $versionParser ?? new VersionParser();
    $stabilities = ['dev', 'alpha', 'beta', 'RC', 'stable'];
    $stabilityIndex = array_search($stability, ['dev', 'alpha', 'beta', 'RC', 'stable'], true);

    if ($stabilityIndex === false) {
        error("Invalid stability: $stability", 2);
    }

    return array_filter(
        $versions,
        function (string $version) use ($versionParser, $stabilities, $stabilityIndex, $required): bool {
            $versionStability = $versionParser->parseStability($version);
            $versionStabilityIndex = array_search($versionStability, $stabilities, true);
            if ($versionStabilityIndex === false) {
                return false;
            }
            if ($required) {
                return $versionStabilityIndex === $stabilityIndex;
            }
            return $versionStabilityIndex >= $stabilityIndex;
        },
    );
}

/**
 * Format the output of the version information based on the specified format.
 *
 * @param string $outForm The output format ('refspec', 'text', 'branchtag', 'json').
 * @param string $latest The latest version.
 * @param array<string> $matchingVersions The list of versions matching the constraint.
 * @param array<string, array{refspec: string, commit: string}> $versions The list of all versions.
 * @return string The formatted output.
 */
function formatOutput(string $outForm, string $latest, array $matchingVersions, array $versions): string
{
    if ($latest === '' || empty($matchingVersions) || empty($versions)) {
        return '';
    }

    $output = [
        'latest' => [
            'version' => $latest,
            'refspec' => $versions[$latest]['refspec'] ?? '',
            'refname' => preg_replace('#^refs/(heads|tags)/#', '', $versions[$latest]['refspec']) ?? '',
            'reftype' => str_contains($versions[$latest]['refspec'] ?? '', 'refs/tags/') ? 'tag' : 'branch',
            'commit' => $versions[$latest]['commit'] ?? '',
        ],
    ];
    foreach ($matchingVersions as $version) {
        $output['matching'][] = [
            'version' => $version,
            'refspec' => $versions[$version]['refspec'] ?? '',
            'refname' => preg_replace('#^refs/(heads|tags)/#', '', $versions[$version]['refspec']) ?? '',
            'reftype' => str_contains($versions[$version]['refspec'] ?? '', 'refs/tags/') ? 'tag' : 'branch',
            'commit' => $versions[$version]['commit'] ?? '',
        ];
    }

    switch ($outForm) {
        case 'ref':
        case 'refspec':
            return $output['latest']['refspec'];
        case 'refname':
            return $output['latest']['refname'];
        case 'commit':
            return $output['latest']['commit'];
        case 'composer':
            return $output['latest']['version'];
        case 'text':
            return implode(
                PHP_EOL,
                array_map(
                    fn(string $k, string $v): string => "$k: $v",
                    array_keys($output['latest']),
                    array_values($output['latest']),
                ),
            );
        case 'json':
            return json_encode($output, JSON_PRETTY_PRINT) ?: '{}';
        default:
            error("Invalid output format: $outForm", 2, $outForm);
    }
}

/**
 * Main entry point of the script.
 *
 * @param array<string> $argv The command-line arguments.
 */
function main(array $argv): void
{
    global $VERBOSE, $GITCMD;
    $opts = getopt(
        'r:k:s:g:o:vh?',
        ['repo::', 'sshkey::', 'stability::', 'git::', 'output::', 'verbose', 'help'],
        $rest_index,
    );
    $VERBOSE = isset($opts['verbose']) || isset($opts['v']);
    if (isset($opts['help']) || isset($opts['?']) || isset($opts['h'])) {
        usage(true);
    }
    $constraint = $argv[$rest_index] ?? '';
    if ($constraint === '') {
        error("No version constraint specified", 2);
    }

    /** @var string $repo The path to the Git repository. */
    $repo = $opts['repo'] ?? $opts['r'] ?? '.';
    /** @var string|null $sshKey The path to the SSH key for accessing the repository. */
    $sshKey = $opts['sshkey'] ?? $opts['k'] ?? null;
    /** @var string|null $gitCmd The Git command specified via options or environment variable. */
    $gitCmd = $opts['git'] ?? $opts['g'] ?? (getenv('GITCMD') ?: null);
    if ($gitCmd !== null) {
        $GITCMD = escapeshellcmd($gitCmd);
    }
    /** @var string $outForm The output format for the version information. */
    $outForm = $opts['output'] ?? $opts['o'] ?? 'refspec';

    $versionParser = new VersionParser();
    /** @var string|null $requiredStability The mandatory stability (e.g., 'stable', 'beta'). */
    $requiredStability = $opts['stability'] ?? $opts['s'] ?? null;
    if ($requiredStability !== null) {
        $requiredStability = $versionParser->normalizeStability($requiredStability);
    }

    /* get a list of versions from the repository */
    $versions = getRepoVersions($repo, $sshKey, $versionParser);

    $matchingVersions = Semver::satisfiedBy(array_keys($versions), $constraint);
    if (empty($matchingVersions)) {
        error("No versions match the constraint: $constraint", 1, $outForm);
    }

    $stability = $requiredStability ?? $versionParser->parseStability($constraint);
    verbose("Desired stability: $stability");
    $matchingVersions = filterByStability($matchingVersions, $stability, $requiredStability !== null, $versionParser);
    if (empty($matchingVersions)) {
        error("No versions matching '$constraint' satisfy the stability constraint: $stability", 1, $outForm);
    }

    $matchingVersions = Semver::sort($matchingVersions);
    verbose("Matching versions: " . implode(', ', $matchingVersions));
    $latestVersion = end($matchingVersions) ?: '';

    echo formatOutput($outForm, $latestVersion, $matchingVersions, $versions) . PHP_EOL;
    exit(0);
}

if (PHP_SAPI !== 'cli' && PHP_SAPI !== 'phpdbg') {
    error(
        'Warning: ' . PROGRAM_NAME . ' should be invoked via the CLI version of PHP, not the ' . PHP_SAPI . ' SAPI',
        2,
    );
}

set_exception_handler(function (Throwable $e): void {
    error('Unhandled exception: ' . $e->getMessage(), 2);
});

setlocale(LC_ALL, 'C');
require __DIR__ . '/../vendor/autoload.php';

/** @var bool $VERBOSE Whether to enable verbose output. */
$VERBOSE = false;
/** @var string $GITCMD The Git command to use. */
$GITCMD = 'git';

main($argv ?? []);
