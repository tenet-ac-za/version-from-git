{
    "name": "tenet-ac-za/version-from-git",
    "description": "Extract the most recent version from a git repository matching a composer-like constraint",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Guy Halse",
            "homepage": "http://orcid.org/0000-0002-9388-8592"
        }
    ],
    "require": {
        "composer/semver": "^3.3"
    },
    "support": {
        "issues": "https://github.com/tenet-ac-za/version-from-git/issues",
        "source": "https://github.com/tenet-ac-za/version-from-git"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0",
        "slevomat/coding-standard": "^8.25",
        "humbug/box": "^4.7"
    },
    "bin": [
        "bin/version-from-git"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
